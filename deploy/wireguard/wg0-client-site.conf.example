# /etc/wireguard/wg0.conf  (máquina do cliente — gerado pelo painel)
# NETMAP: bloco VPN do site → LAN real (1:1). Ajuste a iface (eth0 / wlan0 / wlx…).
[Interface]
Address = 10.10.10.3/32
PrivateKey = <SITE_PRIVATE_KEY>
PostUp = sysctl -w net.ipv4.ip_forward=1; iptables -t nat -A PREROUTING -i wg0 -d 10.20.2.0/24 -j NETMAP --to 192.168.1.0/24; iptables -A FORWARD -i wg0 -j ACCEPT; iptables -A FORWARD -o wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
PostDown = iptables -t nat -D PREROUTING -i wg0 -d 10.20.2.0/24 -j NETMAP --to 192.168.1.0/24; iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE

[Peer]
PublicKey = <SERVER_PUBLIC_KEY>
Endpoint = <VPS_PUBLIC_IP>:51820
AllowedIPs = 10.10.10.1/32
PersistentKeepalive = 25

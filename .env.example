ADMIN_EMAIL=ivanrank@yahoo.com.br
ADMIN_PASSWORD=change-me
SECRET_KEY=replace-with-long-random-string
CAMERA_SECRET_KEY=replace-with-another-long-random-string
DATABASE_URL=sqlite:////data/nvr.db
DEFAULT_STORAGE_PATH=/recordings
GO2RTC_CONFIG_PATH=/config/go2rtc.yaml
GO2RTC_API=http://127.0.0.1:1984
GO2RTC_PUBLIC_URL=http://127.0.0.1:1984
# VPS behind nestertec.com path (leave empty for local root):
# PUBLIC_BASE_PATH=/adm/house/monitor
# GO2RTC_PUBLIC_URL=/adm/house/monitor/rtc
PUBLIC_BASE_PATH=
DISK_RESERVE_BYTES=2147483648
SEGMENT_SECONDS=300
QUOTA_GB=50
# WireGuard multi-site (VPS) — required for client .conf download
# WG_SERVER_PUBLIC_KEY=
# WG_SERVER_ENDPOINT=191.252.208.229:51820
# WG_SERVER_TUNNEL_IP=10.10.10.1
# WG_TUNNEL_NETWORK=10.10.10.0/24
# WG_VPN_BASE=10.20.0.0/16
# WG_PEERS_DIR=/data/wireguard/peers
# Optional host script (outside Docker): WG_APPLY_CMD=/usr/local/bin/icsee-apply-peer.sh
